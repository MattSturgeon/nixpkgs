From dd9bc8f95d99e7fd8ed58869137b66d837a49197 Mon Sep 17 00:00:00 2001
From: Sewer56 <sewer56lol@googlemail.com>
Date: Thu, 22 Aug 2024 00:15:30 +0100
Subject: [PATCH 1/3] Fixed: Alias USE_SYSTEM_EXTRACTOR and
 NEXUSMODS_APP_USE_SYSTEM_EXTRACTOR

---
 .../NexusMods.FileExtractor/Extractors/SevenZipExtractor.cs | 2 +-
 .../build/NexusMods.FileExtractor.targets                   | 6 +-----
 2 files changed, 2 insertions(+), 6 deletions(-)

diff --git a/src/ArchiveManagement/NexusMods.FileExtractor/Extractors/SevenZipExtractor.cs b/src/ArchiveManagement/NexusMods.FileExtractor/Extractors/SevenZipExtractor.cs
index 05006edc..e6d152b5 100644
--- a/src/ArchiveManagement/NexusMods.FileExtractor/Extractors/SevenZipExtractor.cs
+++ b/src/ArchiveManagement/NexusMods.FileExtractor/Extractors/SevenZipExtractor.cs
@@ -219,7 +219,7 @@ private static string GetExtractorExecutable(IFileSystem fileSystem)
     /// See https://github.com/Nexus-Mods/NexusMods.App/issues/1306 for details.
     /// </remarks>
     private const bool UseSystemExtractor =
-#if USE_SYSTEM_EXTRACTOR
+#if NEXUSMODS_APP_USE_SYSTEM_EXTRACTOR || USE_SYSTEM_EXTRACTOR
         true;
 #else
         false;
diff --git a/src/ArchiveManagement/NexusMods.FileExtractor/build/NexusMods.FileExtractor.targets b/src/ArchiveManagement/NexusMods.FileExtractor/build/NexusMods.FileExtractor.targets
index ff5e4d51..da677125 100644
--- a/src/ArchiveManagement/NexusMods.FileExtractor/build/NexusMods.FileExtractor.targets
+++ b/src/ArchiveManagement/NexusMods.FileExtractor/build/NexusMods.FileExtractor.targets
@@ -13,12 +13,8 @@
     <_NativeRuntime Condition=" '$(_NativeRuntime)' == '' And '$(_IsWindows)' == 'true' And ('$(Prefer32Bit)' == 'true' Or '$(PlatformTarget)' == 'x86')">win-x86</_NativeRuntime>
     <_NativeRuntime Condition=" '$(_NativeRuntime)' == '' And '$(_IsWindows)' == 'true' And ('$(Prefer32Bit)' == 'false' Or '$(PlatformTarget)' == 'x64')">win-x64</_NativeRuntime>
 
-      <_UseSystemExtractor Condition="'$(NEXUSMODS_APP_USE_SYSTEM_EXTRACTOR)' == '1'">true</_UseSystemExtractor>
+    <_UseSystemExtractor Condition="$([System.String]::new('$(DefineConstants)').Contains('USE_SYSTEM_EXTRACTOR')) or $([System.String]::new('$(DefineConstants)').Contains('NEXUSMODS_APP_USE_SYSTEM_EXTRACTOR'))">true</_UseSystemExtractor>
   </PropertyGroup>
-    
-    <PropertyGroup Condition="'$(_UseSystemExtractor)' == 'true'">
-        <DefineConstants>USE_SYSTEM_EXTRACTOR</DefineConstants>
-    </PropertyGroup>
 
   <ItemGroup Condition="'$(_UseSystemExtractor)' == '' Or '$(_UseSystemExtractor)' == 'false'">
     <!-- Copy all if platform not specified -->
-- 
2.45.2

